{
  "name": "km-delen",
  "private": true,
  "version": "1.0.0",
  "description": "Kilometers en tankbeurten bijhouden voor een gedeelde auto",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check public/app.js && node --check public/core.js",
    "vendor": "esbuild scripts/vendor-three.mjs --bundle --format=esm --minify --legal-comments=eof --outfile=public/vendor/three-bundle.js",
    "buurt": "node scripts/build-buurt.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.25.12",
    "three": "^0.187.0"
  },
  "dependencies": {
    "postgres": "^4.1.1"
  }
}
